# ==========================================
# .gitignore — DockerFactor Project
# ==========================================
# ------------------------------------------
# .NET / C# Build Artifacts
# ------------------------------------------
bin/
obj/
publish/
out/
*.user
*.useros
*.sln.docstates
*.suo
*.userprefs
*.cache
*.deps.json
*.runtimeconfig.json
# .NET Native AOT & Cross-Compilation Build Outputs
*.so
*.dylib
*.dll
*.exe
*.pdb
*.aot
*.rsp
# ------------------------------------------
# Environment & Secrets (NEVER COMMIT SECRETS)
# ------------------------------------------
.env
.env.local
.env.*.local
*.env
*.key
*.pem
*.pfx
*.crt
cert.pem
credentials.json
tunnel-token.txt
pairing-token.txt
# ------------------------------------------
# Docker & Host Temporary Artifacts
# ------------------------------------------
.docker/
*.log
docker-factor-agent.log
cgroup_metrics.json
# ------------------------------------------
# IDEs & Editors
# ------------------------------------------
# Visual Studio
.vs/
[Dd]ebug/
[Rr]elease/
*.rsuser
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
# JetBrains Rider / ReSharper
.idea/
*.sln.iml
# ------------------------------------------
# OS Generated Files
# ------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
