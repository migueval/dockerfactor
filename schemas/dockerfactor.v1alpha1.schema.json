{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockerfactor.dev/schemas/dockerfactor.v1alpha1.schema.json",
  "title": "DockerFactor Application Manifest",
  "description": "Declarative application contract supported by DockerFactor v1alpha1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "dockerfactor.dev/v1alpha1"
    },
    "kind": {
      "const": "Application"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "port"],
      "properties": {
        "runtime": {
          "type": "string",
          "enum": ["angular", "dotnet", "generic", "go", "nestjs", "node", "python"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "build": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    }
  }
}
